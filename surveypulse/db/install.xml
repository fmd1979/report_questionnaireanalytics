<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/surveypulse/db" VERSION="2026100700" COMMENT="SurveyPulse independent survey activity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="surveypulse" COMMENT="surveypulse">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
        <FIELD NAME="course" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="name" TYPE="char" NOTNULL="true" SEQUENCE="false" LENGTH="255" />
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false" />
        <FIELD NAME="introformat" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="4" DEFAULT="0" />
        <FIELD NAME="anonymous" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="1" DEFAULT="1" />
        <FIELD NAME="minresponses" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="4" DEFAULT="5" />
        <FIELD NAME="timeopen" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="timeclose" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="timecreated" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="timemodified" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" />
        <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id" />
      </KEYS>
    </TABLE>
    <TABLE NAME="surveypulse_question" COMMENT="surveypulse question">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
        <FIELD NAME="surveyid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="label" TYPE="text" NOTNULL="false" SEQUENCE="false" />
        <FIELD NAME="qtype" TYPE="char" NOTNULL="true" SEQUENCE="false" LENGTH="20" DEFAULT="single" />
        <FIELD NAME="options" TYPE="text" NOTNULL="false" SEQUENCE="false" />
        <FIELD NAME="required" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="1" DEFAULT="1" />
        <FIELD NAME="sortorder" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="1" />
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" />
        <KEY NAME="surveyid" TYPE="foreign" FIELDS="surveyid" REFTABLE="surveypulse" REFFIELDS="id" />
      </KEYS>
    </TABLE>
    <TABLE NAME="surveypulse_response" COMMENT="surveypulse response">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
        <FIELD NAME="surveyid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="userid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="timecreated" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" />
        <KEY NAME="surveyid" TYPE="foreign" FIELDS="surveyid" REFTABLE="surveypulse" REFFIELDS="id" />
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid" />
      </INDEXES>
    </TABLE>
    <TABLE NAME="surveypulse_answer" COMMENT="surveypulse answer">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
        <FIELD NAME="responseid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="questionid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="value" TYPE="text" NOTNULL="false" SEQUENCE="false" />
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" />
        <KEY NAME="responseid" TYPE="foreign" FIELDS="responseid" REFTABLE="surveypulse_response" REFFIELDS="id" />
        <KEY NAME="questionid" TYPE="foreign" FIELDS="questionid" REFTABLE="surveypulse_question" REFFIELDS="id" />
      </KEYS>
    </TABLE>
    <TABLE NAME="surveypulse_receipt" COMMENT="surveypulse receipt">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
        <FIELD NAME="surveyid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="userid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" />
        <KEY NAME="surveyid" TYPE="foreign" FIELDS="surveyid" REFTABLE="surveypulse" REFFIELDS="id" />
      </KEYS>
      <INDEXES>
        <INDEX NAME="survey-user" UNIQUE="true" FIELDS="surveyid, userid" />
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
